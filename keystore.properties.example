# Plantilla de keystore.properties (Sesión 14, Paso 3).
# Copia este archivo como keystore.properties en esta misma carpeta y completa
# los valores. keystore.properties está en .gitignore: nunca se sube.
# En Windows usa barras normales en la ruta: C:/Users/tu_usuario/claves/equipo.jks
storeFile=C:/ruta/fuera/del/repositorio/equipo.jks
storePassword=CAMBIAR
keyAlias=equipo
keyPassword=CAMBIAR
